# Copy to .env.local and adjust. Every value is optional; defaults are shown.
# Vite inlines VITE_* values into the client bundle, so never put secrets here.

# Name shown in the page header.
VITE_APP_NAME=CodeFlow

# Web origin of GitHub, used for "Open on GitHub" links when the API response doesn't
# include one. The public GitHub connector only reaches github.com, so leave this as is.
VITE_GITHUB_HOST=https://github.com

# Shareable URL of the deployed app (from `npx ms app play`). Deep links append their
# query to it. Leave empty to link to the current page.
VITE_APP_URL=

# Player used to build share links while running `npm run dev`.
VITE_DEV_PLAYER_URL=https://play.preview.managedapps.cloud.microsoft

# Storage provider registered in src/storage/index.ts. `local` keeps data in this browser.
VITE_STORAGE_PROVIDER=local

# Prefix that isolates this app's browser storage from other apps on the same origin.
VITE_APP_STORAGE_PREFIX=codeflow
