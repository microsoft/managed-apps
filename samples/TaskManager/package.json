{
  "name": "taskmanager-template",
  "private": true,
  "version": "0.1.0",
  "description": "Task Manager: a Windows 95-styled team work board over Azure DevOps, an app hosted on Copilot Managed Runtime.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "predev": "node scripts/check-setup.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-setup.mjs",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "check-setup": "node scripts/check-setup.mjs",
    "storage:describe": "tsx scripts/storage-describe.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@microsoft/managed-apps": "^0.6.3",
    "@tanstack/react-query": "^5.87.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.6.0",
    "react": "^19.1.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@microsoft/managed-apps-cli": "0.32.2",
    "@microsoft/managed-apps-vite-plugin": "^0.4.8",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.39.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/types": "8.39.0",
    "@typescript-eslint/tsconfig-utils": "8.39.0"
  }
