# Copy to .env.local and fill in. Values are read at build time by src/config.ts.
# Never put secrets here: every VITE_* value is compiled into the browser bundle.

# --- Azure DevOps (required) ------------------------------------------------
# Organization and project the board reads and writes, e.g. contoso / Fabrikam Web.
VITE_ADO_ORG=
VITE_ADO_PROJECT=
# Area path to load work from (recursive). Defaults to the project root.
# Example: Fabrikam Web\Team A
VITE_ADO_AREA_PATH=
# Sub-areas (directly under the area path) shown as coloured backlog columns.
# Example: Frontend,Backend,Platform
VITE_ADO_AREAS=

# --- Azure DevOps process (optional; defaults suit the Agile process) --------
# VITE_ADO_BOARD_WORK_ITEM_TYPES=User Story,Feature,Epic
# VITE_ADO_STORY_TYPE=User Story
# VITE_ADO_BUG_TYPE=Bug
# VITE_ADO_TASK_TYPE=Task
# States hidden from the board, and states listed on the Completed tab.
# VITE_ADO_EXCLUDED_STATES=Closed,Removed
# VITE_ADO_COMPLETED_STATES=Closed

# --- Team (optional) ----------------------------------------------------------
# Display names that always get an Engineers column, in this order.
# Example: Avery Example,Jordan Sample
VITE_TEAM_MEMBERS=

# --- Links (optional, https only) --------------------------------------------
# Public URL of the deployed app, used in copied links and Teams messages.
# Defaults to the current page address.
VITE_APP_URL=
# Tracker scenarios can link to issues. When set, links must live under this base,
# e.g. https://github.com/contoso/app/issues. When empty, any https URL is accepted.
VITE_ISSUE_TRACKER_BASE_URL=

# --- Teams ETA request (optional) --------------------------------------------
# Placeholders: {assignee} {requester} {id} {title} {link}
# VITE_ETA_MESSAGE_TEMPLATE=Hi {assignee}, {requester} asked for an ETA on {link}. Could you set a target date on the work item?

# --- Storage (optional) -------------------------------------------------------
# Provider for app-owned data (retro notes, trackers, tags, notes, feedback).
# `local` keeps data in this browser. Add shared providers with the add-data-source skill.
VITE_STORAGE_PROVIDER=local
# Key prefix that isolates this app's browser data from other apps on the same origin.
VITE_APP_STORAGE_PREFIX=taskmanager
