# Copy to .env.local and adjust. Every variable is optional; the defaults are shown.
# Values are baked into the build (Vite exposes VITE_* variables to the browser), so never put secrets here.

# --- Branding -------------------------------------------------------------------------------
# Product name in the top bar and browser tab.
VITE_APP_NAME=Learning Hub
# Heading on the home page and the series description under it.
VITE_SERIES_NAME=Learning Series
VITE_SERIES_DESCRIPTION=Weekly sessions where people share what they’ve learned. Catch up on past sessions and see what’s next.

# --- Schedule -------------------------------------------------------------------------------
# Day of the week sessions happen: 0 = Sunday, 1 = Monday, ... 6 = Saturday.
VITE_SERIES_WEEKDAY=4
# Start and end time (24-hour HH:MM) in VITE_SERIES_TIME_ZONE.
VITE_SERIES_START_TIME=09:00
VITE_SERIES_END_TIME=10:00
# IANA time zone name, e.g. America/New_York, Europe/London, Asia/Tokyo.
VITE_SERIES_TIME_ZONE=America/Los_Angeles
# Last date of the series (yyyy-mm-dd). Leave empty for an open-ended series.
VITE_SERIES_END_DATE=
# How many upcoming weeks the sign-up page lists when there is no end date (1-104).
VITE_SERIES_WEEKS_AHEAD=12
# Comma-separated dates (yyyy-mm-dd) to label as holiday weeks.
VITE_SERIES_SKIP_DATES=

# --- Storage --------------------------------------------------------------------------------
# Which provider in src/storage/index.ts stores the data. "local" keeps data in this browser.
# Add shared providers (SharePoint, Dataverse, ...) with .github/skills/add-data-source/SKILL.md.
VITE_STORAGE_PROVIDER=local
# Prefix for this app's keys in browser storage (letters, digits, - and _).
VITE_APP_STORAGE_PREFIX=learninghub
# Seed a few fictional past sessions on first run (local storage only). true or false.
VITE_SEED_SAMPLE_DATA=true

# --- Sharing --------------------------------------------------------------------------------
# Public https URL of the deployed app, used to build share links. Leave empty to derive it
# from the page that hosts the app.
VITE_PUBLIC_APP_URL=